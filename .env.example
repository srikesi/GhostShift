# Faultzy configuration. Copy to `.env` (repo root) and edit. Never commit `.env`.
# Every value is optional: with nothing set, Faultzy runs fully offline in demo mode.

# demo | aws | auto  (see README "Execution modes")
FAULTZY_MODE=demo

# Base URL used in SMS inspection links (the frontend origin the technician can reach).
FAULTZY_PUBLIC_BASE_URL=http://localhost:5173
# JSON list of allowed browser origins for the API.
# FAULTZY_CORS_ORIGINS=["http://localhost:5173"]

# --- Deployment (workstream 2 adds settings here) -------------------------
# Serve the built frontend from the API (single container): path to frontend/dist.
# FAULTZY_STATIC_DIR=/app/frontend/dist

# --- Amazon Bedrock (Converse) -------------------------------------------
# Credentials come from the standard AWS chain (env vars, ~/.aws, SSO, role).
# Verify access first:  make check-bedrock
FAULTZY_LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
# Use the model or inference-profile id enabled in YOUR account, e.g. a "us." profile id.
FAULTZY_BEDROCK_MODEL_ID=
FAULTZY_LLM_TIMEOUT_S=20
FAULTZY_LLM_MAX_ATTEMPTS=2
# (workstream 1 adds copilot / agent settings here)

# --- Twilio SMS (opt-in) ---------------------------------------------------
# stub | twilio. Real SMS is only ever sent to FAULTZY_DEMO_TECHNICIAN_PHONE.
FAULTZY_SMS_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
FAULTZY_DEMO_TECHNICIAN_PHONE=

# --- ElevenLabs voice (optional) -------------------------------------------
# stub | elevenlabs
FAULTZY_VOICE_PROVIDER=stub
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Data (workstream 3 adds settings here) -------------------------------
# Optional path to the AI4I 2020 CSV; registers machine AI4I-MILL.
# FAULTZY_AI4I_PATH=/absolute/path/to/ai4i2020.csv
FAULTZY_INSPECTION_TOKEN_TTL_HOURS=12
