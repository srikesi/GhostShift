# GhostShift Environment Configuration for Live Demo
# Copy this file or paste your keys directly into backend/.env

# Execution Mode: Set to "auto" so configured real providers (Twilio, ElevenLabs) are automatically enabled!
GHOSTSHIFT_MODE=auto

# Frontend / Demo URL
GHOSTSHIFT_PUBLIC_BASE_URL=http://localhost:5173

# --- Twilio SMS & Calls ---
# GHOSTSHIFT_SMS_PROVIDER: Set to "twilio" to activate real SMS dispatch
GHOSTSHIFT_SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Where to send the technician SMS alerts (your personal phone, e.g. +15125551234)
GHOSTSHIFT_DEMO_TECHNICIAN_PHONE=

# Optional: Extra alert phones (comma-separated, e.g. teammate's phone)
# GHOSTSHIFT_ALERT_PHONES=+15125559876

# Optional: Number for live voice call scheduling
# GHOSTSHIFT_SCHEDULER_CALL_PHONE=+15125551234
# GHOSTSHIFT_CALL_FROM_NUMBER=

# --- ElevenLabs Voice ---
# GHOSTSHIFT_VOICE_PROVIDER: Set to "elevenlabs" to activate real speech synthesis
GHOSTSHIFT_VOICE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Amazon Bedrock LLM (Optional) ---
# AWS_REGION=us-east-1
# GHOSTSHIFT_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
