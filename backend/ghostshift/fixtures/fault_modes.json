        "estimated_duration_hours": 3.0,
        "required_skills": [
          "Critical facilities technician",
          "Electrical (qualified)"
        ],
        "tasks": [
          {
            "description": "Confirm the failover rack (MF-08) is carrying the workload and inlet temperatures are stable before taking MF-07 offline.",
            "requires_qualified_person": false
          },
          {
            "description": "Confirm the vibration reading with a portable analyser at the fan tray.",
            "requires_qualified_person": false
          },
          {
            "description": "Isolate the rack's power feeds and verify zero energy per the site LOTO procedure.",
            "requires_qualified_person": true
          },
          {
            "description": "Slide out the rear fan tray, replace both motor bearings, and check the fan blades for damage.",
            "requires_qualified_person": true
          },
          {
            "description": "Power the rack back up; confirm vibration, bearing temperature and airflow return to normal and inlet temperatures hold.",
            "requires_qualified_person": false
          }
        ],
        "safety_references": [
          "Site LOTO procedure (reference only)",
          "Data hall change-control / method of procedure (MOP)",
          "OEM fan tray service guide"
        ]
      }
