          },
          {
            "description": "Remove the fan module, replace both motor bearings, and check the impeller for damage.",
            "requires_qualified_person": true
          },
          {
            "description": "Restart the unit; confirm vibration, bearing temperature and airflow return to normal and cold-aisle temperatures hold.",
            "requires_qualified_person": false
          }
